# prime numbeer

n = int(input("enter the num:"))
if(n<=1):
    print(n,"is not prime")
else:
    for i in range(2, n):
        if n % i == 0:
            print(n, "is not a prime number")
            break
    else:
        print(n, "is a prime number")

