# sum of digit with reccursion

def sum_of_digits(n):
    if n == 0:           # Base case: if number is 0
        return 0
    else:
        return n % 10 + sum_of_digits(n // 10)  # Last digit + sum of remaining digits
num = 12345
result = sum_of_digits(num)
print("Sum of digits:", result)


# sum of digit without reccursion

def sum(n):

    while n>0:
        total = 0
        digit = n%10
        total+=digit
        n = n//10
    return total
print(sum(12345))

