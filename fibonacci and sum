# fibonacii  term using recursion
def fibonacii(n):
    if n==0:
        return 0
    elif(n==1):
        return 1
    else :
        return fibonacii(n-1) + fibonacii(n-2)
print(fibonacii(6))

#fibonacii term without recursion
def fibonacci(n):
    sequence = [0, 1]   # Initialize first two terms
    
    for i in range(2, n):
        next_term = sequence[-1] + sequence[-2]
        sequence.append(next_term)
    return sequence[n-1]
num = 10
print(fibonacci(num))

