# abstraction

from abc import ABC, abstractmethod

# Abstract class
class Person(ABC):

    def __init__(self, name, age):
        self.name = name
        self.age = age

    # Abstract method
    @abstractmethod
    def show_details(self):
        pass
class Student(Person):
    def __init__(self, name, age, rollno):
        super().__init__(name, age) # it hides how from where name comes 
        self.rollno = rollno

    # Implementing abstract method
    def show_details(self):
        print(f"Name: {self.name}, Age: {self.age}, Roll No: {self.rollno}")


# Object creation
s = Student("Ishu", 21, 7)
s.show_details()  

