class Complex:
    def __init__(self, i, j, k):
        self.i = i
        self.j = j
        self.k = k

    def __add__(self, other):
        return Complex(self.i + other.i,
                       self.j + other.j,
                       self.k + other.k)

    def __mul__(self, other):
        return Complex(self.i * other.i,
                       self.j * other.j,
                       self.k * other.k)

    def __str__(self):
        return f"{self.i}i + {self.j}j + {self.k}k"


