# Program to detect double spaces in a string

text = input("Enter a string: ")

# Method 1: using find()
pos = text.find("  ")   # returns index of first double space, -1 if not found

if pos != -1:
    print("Double space found at index:", pos)
else:
    print("No double spaces found.")

