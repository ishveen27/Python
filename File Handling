# seek,tell and truncate
with open('myfile.txt','w+') as f:
    f.write("HELLO WORLD")
    f.seek(6)        # move cursor after "HELLO "
    f.truncate()     # content is erased from 6  cut from here
    print("Cursor at:", f.tell())
    f.seek(0)
    print("Cursor at:", f.tell())
    print("File content:", f.read())
