# Hindi to English dictionary
hindi_english = {
    "नमस्ते": "Hello",
    "पानी": "Water",
    "घर": "Home",
    "धन्यवाद": "Thank you",
    "सूरज": "Sun",
    "चाँद": "Moon"
}

# User input to look up a word
word = input("Enter a Hindi word to translate: ")

# Look up the word
if word in hindi_english:
    print(f"The English translation of '{word}' is '{hindi_english[word]}'")
else:
    print(f"Sorry, '{word}' is not in the dictionary.")

