#_name is "private" by convention (the underscore _ signals it shouldn’t be accessed directly from outside the class).

#traditional gettter and setter method
class Student:
    def __init__(self, name, rollno):
        self.__name = name       # private attribute
        self.__rollno = rollno   # private attribute

    # Getter method for name
    def get_name(self):
        return self.__name

    # Setter method for name
    def set_name(self, name):
        self.__name = name

    # Getter method for rollno
    def get_rollno(self):
        return self.__rollno

    # Setter method for rollno
    def set_rollno(self, rollno):
        self.__rollno = rollno
    def display(self):
        print(f"Name: {self.__name}, Roll No: {self.__rollno}")
# Creating object
s = Student("Ishu", 7)

# Accessing private attributes using getter
print(s.get_name())    # Ishu
print(s.get_rollno())  # 7
s.display()
# Updating private attributes using setter
s.set_name("Arsh")
s.set_rollno(2)

print(s.get_name())    # Arsh
print(s.get_rollno())  # 2
s.display()

# getter and setter with multiple properties
class Student:
    def __init__(self, name, rollno):
        self._attributes = {"name": name, "rollno": rollno}

    # Generic getter
    def get_attr(self, key):
        return self._attributes.get(key)

    # Generic setter
    def set_attr(self, key, value):
        self._attributes[key] = value

# Usage
s = Student("Ishu", 7)
print(s.get_attr("name"))     # Ishu
print(s.get_attr("rollno"))   # 7

s.set_attr("name", "Arsh")
s.set_attr("rollno", 2)

print(s.get_attr("name"))     # Arsh
print(s.get_attr("rollno"))   # 2

