# class method as alternate constructor
class Student:
    def __init__(self, name, rollno):
        self.name = name
        self.rollno = rollno

    @classmethod
    def string(cls, data):   # alternate constructor here data is "Arsh-102",cls is student
        name, rollno = data.split("-") # unpacking list
        return cls(name, int(rollno))

# 2 ways to create a Student:
s1 = Student("Ishveen", 101)        # normal constructor
s2 = Student.string("Arsh-102") # alternate constructor
print(s1.name,s2.age)


#other example
class Student:
    def __init__(self, name, rollno):
        self.name = name
        self.rollno = rollno

    @classmethod
    def string(cls, data):   # alternate constructor
      return cls(data.split("-")[0],data.split("-")[1])

