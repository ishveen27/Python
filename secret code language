# CODE WITH HARRY APPROACH

word = input("enter the message:")
str = word.split(" ")
coding = input("enter 1 for coding and 0 for decoding :")
coding = True if (coding == "1") else False
if(coding):
    new = []
    for words in str:
     if(len(words)>3):
        r1 = "abc"
        r2 =  "xyz"
        m_words = r1+ words[1:] + words[0] + r2
        new.append(m_words)
     else:
      new.append(words[::-1])
    print("Encoded message:", " ".join(new))
# " ".join(new) → joins all elements of a list into one string, using " " (a space) as the separator.
else: 
    new = []

    for words in str: 
      if(len(words)>3):
        core = words[3:-3]
        decode_new_word = core[-1] + core[:-1]
        new.append(decode_new_word)
      else:
         new.append(words[::-1])
    print("decoded message:", " ".join(new))

