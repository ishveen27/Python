#recursion func to calculate sum of first n natural numbers
def sum(n):
     if n == 0:
          return 0
     else :
          return n + sum(n-1) # func calling itself
n = int(input("enter the num:"))
a = sum(n)
print(a)

# factorical using recursion
def fact(n):
     if(n==0 or n==1):
          return 1
     else :
          return n * fact(n-1)
n = int(input("enter te num:"))
c = fact(n)
print(c)


# fibonacii using recurison
def fibonacci(n):
     if(n==0):
          return 0
     elif(n==1):
          return 1
     else:
          return fibonacci(n-1) + fibonacci(n-2)
