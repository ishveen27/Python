# find out if a post is talking about harry or not
''' post.lower() : convert the input into lowercase no matter "HARRY","harry","Harry" '''
post = input("Enter your post: ")
if "harry" in post.lower():   # .lower() makes it case-insensitive
    print("Yes, the post is talking about Harry.")
else:
    print("No, the post is not talking about Harry.")

        
